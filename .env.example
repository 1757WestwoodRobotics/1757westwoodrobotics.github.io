# The Blue Alliance API Key
# Get your key from: https://www.thebluealliance.com/account
VITE_TBA_KEY=your_tba_api_key_here

# Event Key (e.g., 2026rikin)
VITE_EVENT_KEY=2026rikin

# Google Sheets CSV URLs
VITE_SCOUTING_CSV_URL=your_scouting_sheet_url_here
VITE_PIT_CSV_URL=your_pit_sheet_url_here

# Pit Scouting Form URL
VITE_PIT_SCOUTING_FORM_URL=your_pit_form_url_here

# Filter data to only include entries after this time (e.g., 2026-03-28T09:00:00)
VITE_FILTER_TIME=
